# ---
# .env.dockerexample
# 复制为 .env, docker compose 自动加载
# 这是 Docker 专用配置, 主机 .env 不影响
# ---

# ────────────────────────────────────────────────────────────
# 1. 厂商选择 + API Key (二选一填, 至少 1 个)
# ────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
KIMI_API_KEY=
SILICONFLOW_API_KEY=

# ────────────────────────────────────────────────────────────
# 2. Docker 镜像构建参数 (可选, 国内用户加速)
# ────────────────────────────────────────────────────────────

# 国内 Docker 镜像 (默认 docker.io, 国内可换阿里云)
# DOCKER_REGISTRY=registry.cn-hangzhou.aliyuncs.com

# 国内 pip 源 (默认清华)
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# HuggingFace 镜像 (默认 hf-mirror, 国内访问快)
# HF_ENDPOINT=https://hf-mirror.com

# ────────────────────────────────────────────────────────────
# 3. 中间件 (Redis 端口由 compose 自动映射, Postgres 仅 gpu profile)
# ────────────────────────────────────────────────────────────

# Redis (llm / gpu profile 自动启动)
REDIS_URL=redis://redis:6379/0

# Postgres (gpu profile 启动, 默认密码请改)
# POSTGRES_PASSWORD=your_secure_password

# ────────────────────────────────────────────────────────────
# 4. 端口映射 (仅说明, compose 中已配置)
# ────────────────────────────────────────────────────────────
# app: 8000 (FastAPI) / 8888 (Jupyter, 可选)
# redis: 6379
# postgres: 5432
