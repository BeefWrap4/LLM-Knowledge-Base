# Docker 排除文件 (减小 build context)
.git/
.github/
.vscode/
.idea/
.claudian/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 排除大文件
code/models/
code/.venv/
code/venv/
.venv/
venv/

# 排除 secrets (用户运行时挂载)
.env
.env.local
.env.*.local

# 排除测试 artifacts
*.png
*.jpg
*.svg
test.txt
output/
figures/

# 根目录教程 Markdown 与 docs/ 是容器内 verify_all.py 的验收输入，必须保留。
