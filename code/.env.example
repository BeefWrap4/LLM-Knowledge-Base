# ---
# code/.env.example
# 复制为 .env 并填入你的 API Key (至少一家厂商, 推荐 DeepSeek 或 Kimi)
# 加载机制: shared/env.py 启动时自动 load (向上查找 3 层)
# ---
# ──────────────────────────────────────────────────────────────────
# 1. 厂商选择 (默认 deepseek, 可选 kimi / siliconflow / openai)
# ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek

# ──────────────────────────────────────────────────────────────────
# 2. 厂商 API Keys (3 选 1 或全填, 至少 1 个)
# ──────────────────────────────────────────────────────────────────

# DeepSeek (https://platform.deepseek.com) — 价格会调整，请查官方实时页（核验：2026-07-31）
# https://api-docs.deepseek.com/quick_start/pricing/
DEEPSEEK_API_KEY=

# Kimi / Moonshot (https://platform.moonshot.cn) — 长上下文 128K, 新用户 ¥15 体验金
KIMI_API_KEY=

# SiliconFlow (https://cloud.siliconflow.cn) — Qwen/GLM/DeepSeek 多模型路由, 注册送额度
SILICONFLOW_API_KEY=

# MiniMax (https://api.minimaxi.com) — Codin Plan (key prefix sk-cp-), 编码优化
MINIMAX_API_KEY=

# OpenAI (可选) — 留空则降级到 mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────
# 3. 默认模型 (每个 provider 的主力)
# ──────────────────────────────────────────────────────────────────
# DeepSeek:  deepseek-v4-flash / deepseek-v4-pro（均支持思考/非思考，1M 上下文，最大输出 384K）
# 注意: deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役，不要再用于新配置
# Kimi:      kimi-k2.5（调用前以官方模型列表为准）
# SiliconFlow: Qwen/Qwen3.6-27B / deepseek-ai/DeepSeek-V4-Pro（模型会动态上下线）
# MiniMax:   MiniMax-M2.7
# OpenAI:    gpt-5.6
# Anthropic: claude-fable-5

# ──────────────────────────────────────────────────────────────────
# 4. 可观测性 (可选, 留空跳过)
# ──────────────────────────────────────────────────────────────────
# LANGCHAIN_API_KEY=                # LangSmith tracing
# WANDB_API_KEY=                    # Weights & Biases
# HF_TOKEN=                         # HuggingFace (私有模型需要)
