# ---
# code/.env.example
# 复制为 .env 并填入你的 API Key (至少一家厂商, 推荐 DeepSeek 或 Kimi)
# 加载机制: shared/env.py 启动时自动 load (向上查找 3 层)
# ---
# ──────────────────────────────────────────────────────────────────
# 1. 厂商选择 (默认 deepseek, 可选 kimi / siliconflow / openai)
# ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek

# ──────────────────────────────────────────────────────────────────
# 2. 厂商 API Keys (3 选 1 或全填, 至少 1 个)
# ──────────────────────────────────────────────────────────────────

# DeepSeek (https://platform.deepseek.com) — 推理强, ¥1/百万 token
DEEPSEEK_API_KEY=

# Kimi / Moonshot (https://platform.moonshot.cn) — 长上下文 128K, 新用户 ¥15 体验金
KIMI_API_KEY=

# SiliconFlow (https://cloud.siliconflow.cn) — Qwen/GLM/DeepSeek 多模型路由, 注册送额度
SILICONFLOW_API_KEY=

# MiniMax (https://api.minimaxi.com) — Codin Plan (key prefix sk-cp-), 编码优化
MINIMAX_API_KEY=

# OpenAI (可选) — 留空则降级到 mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────
# 3. 默认模型 (每个 provider 的主力)
# ──────────────────────────────────────────────────────────────────
# DeepSeek:  deepseek-chat (V3) / deepseek-reasoner (R1 推理)
# Kimi:      moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k
# SiliconFlow: Qwen/Qwen2.5-7B-Instruct / deepseek-ai/DeepSeek-V3
# OpenAI:    gpt-4o-mini / gpt-4o

# ──────────────────────────────────────────────────────────────────
# 4. 可观测性 (可选, 留空跳过)
# ──────────────────────────────────────────────────────────────────
# LANGCHAIN_API_KEY=                # LangSmith tracing
# WANDB_API_KEY=                    # Weights & Biases
# HF_TOKEN=                         # HuggingFace (私有模型需要)
